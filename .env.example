# Database Configuration (Separate Variables)
# Sesuaikan dengan konfigurasi MySQL lokal Anda
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="username_database"
DB_PASSWORD="password_database"
DB_NAME="perpustakaan_db"

# Database URL (auto-generated from above variables)
# Jangan edit langsung, akan otomatis terbentuk dari variabel di atas
DATABASE_URL="mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# Next.js Environment
NODE_ENV="development"

# Application Settings
NEXT_PUBLIC_APP_NAME="E-Perpustakaan"
NEXT_PUBLIC_APP_VERSION="1.0.0"
