datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Peran {
  admin
  kepala_perpustakaan
  petugas
}

enum JenisAnggota {
  siswa
  mahasiswa
  guru_dosen
  umum
}

enum KondisiEksemplar {
  baik
  rusak_ringan
  rusak_berat
}

enum StatusEksemplar {
  tersedia
  dipinjam
  dalam_perbaikan
  hilang
}

enum StatusTransaksi {
  dipinjam
  dikembalikan
  terlambat
  hilang
}

enum JenisDenda {
  terlambat
  rusak
  hilang
}

enum StatusPembayaran {
  belum_bayar
  lunas
}

enum StatusReservasi {
  menunggu
  tersedia
  dibatalkan
  selesai
}

enum JenisChecklist {
  buka
  tutup
}

enum StatusKejadian {
  baru
  ditindaklanjuti
  selesai
}

enum StatusOpname {
  berjalan
  selesai
}

enum StatusDitemukan {
  ditemukan
  tidak_ditemukan
  rusak
}

model pengguna {
  id_pengguna           Int                     @id @default(autoincrement())
  nama                  String                  @db.VarChar(100)
  username              String                  @unique @db.VarChar(50)
  password_hash         String                  @db.VarChar(255)
  peran                 Peran
  status_aktif          Boolean                 @default(true)
  created_at            DateTime                @default(now())
  transaksi_peminjaman  transaksi_peminjaman[]
  checklist_operasional checklist_operasional[]
  laporan_kejadian      laporan_kejadian[]
  stock_opname          stock_opname[]
  log_aktivitas         log_aktivitas[]
}

model anggota {
  id_anggota           Int                    @id @default(autoincrement())
  nama                 String                 @db.VarChar(100)
  no_identitas         String                 @unique @db.VarChar(30)
  email                String?                @db.VarChar(100)
  no_telepon           String?                @db.VarChar(20)
  alamat               String?                @db.VarChar(255)
  jenis_anggota        JenisAnggota
  status_aktif         Boolean                @default(true)
  tanggal_daftar       DateTime               @db.Date
  transaksi_peminjaman transaksi_peminjaman[]
  reservasi            reservasi[]
}

model kategori {
  id_kategori    Int             @id @default(autoincrement())
  nama_kategori  String          @db.VarChar(100)
  no_klasifikasi String?         @db.VarChar(20)
  bahan_pustaka  bahan_pustaka[]
}

model bahan_pustaka {
  id_bahan         Int          @id @default(autoincrement())
  id_kategori      Int
  judul            String       @db.VarChar(255)
  pengarang        String?      @db.VarChar(150)
  penerbit         String?      @db.VarChar(150)
  tahun_terbit     Int?
  isbn             String?      @db.VarChar(20)
  nomor_panggil    String?      @db.VarChar(30)
  jumlah_eksemplar Int          @default(1)
  deskripsi        String?      @db.Text
  kategori         kategori     @relation(fields: [id_kategori], references: [id_kategori], onDelete: Cascade)
  eksemplar        eksemplar[]
  reservasi        reservasi[]

  @@index([id_kategori])
}

model eksemplar {
  id_eksemplar        Int                   @id @default(autoincrement())
  id_bahan            Int
  kode_barcode        String                @unique @db.VarChar(30)
  kondisi             KondisiEksemplar      @default(baik)
  status              StatusEksemplar       @default(tersedia)
  lokasi_rak          String?               @db.VarChar(30)
  bahan_pustaka       bahan_pustaka         @relation(fields: [id_bahan], references: [id_bahan], onDelete: Cascade)
  transaksi_peminjaman transaksi_peminjaman[]
  detail_stock_opname detail_stock_opname[]

  @@index([id_bahan])
}

model transaksi_peminjaman {
  id_transaksi           Int             @id @default(autoincrement())
  id_anggota             Int
  id_eksemplar           Int
  id_pengguna            Int
  tanggal_pinjam         DateTime        @db.Date
  tanggal_jatuh_tempo    DateTime        @db.Date
  tanggal_kembali_aktual DateTime?       @db.Date
  jumlah_perpanjangan    Int             @default(0) @db.TinyInt
  status                 StatusTransaksi @default(dipinjam)
  anggota                anggota         @relation(fields: [id_anggota], references: [id_anggota], onDelete: Cascade)
  eksemplar              eksemplar       @relation(fields: [id_eksemplar], references: [id_eksemplar], onDelete: Cascade)
  pengguna               pengguna        @relation(fields: [id_pengguna], references: [id_pengguna], onDelete: Cascade)
  denda                  denda[]

  @@index([id_anggota])
  @@index([id_eksemplar])
  @@index([id_pengguna])
}

model denda {
  id_denda             Int                  @id @default(autoincrement())
  id_transaksi         Int
  jenis_denda          JenisDenda
  nominal              Decimal              @db.Decimal(10, 2)
  status_pembayaran    StatusPembayaran     @default(belum_bayar)
  tanggal_bayar        DateTime?            @db.Date
  transaksi_peminjaman transaksi_peminjaman @relation(fields: [id_transaksi], references: [id_transaksi], onDelete: Cascade)

  @@index([id_transaksi])
}

model reservasi {
  id_reservasi      Int             @id @default(autoincrement())
  id_anggota        Int
  id_bahan          Int
  tanggal_reservasi DateTime        @db.Date
  status            StatusReservasi @default(menunggu)
  anggota           anggota         @relation(fields: [id_anggota], references: [id_anggota], onDelete: Cascade)
  bahan_pustaka     bahan_pustaka   @relation(fields: [id_bahan], references: [id_bahan], onDelete: Cascade)

  @@index([id_anggota])
  @@index([id_bahan])
}

model checklist_operasional {
  id_checklist   Int            @id @default(autoincrement())
  id_pengguna    Int
  tanggal        DateTime       @db.Date
  jenis          JenisChecklist
  item_checklist String         @db.Text
  catatan        String?        @db.Text
  pengguna       pengguna       @relation(fields: [id_pengguna], references: [id_pengguna], onDelete: Cascade)

  @@index([id_pengguna])
}

model laporan_kejadian {
  id_kejadian    Int            @id @default(autoincrement())
  id_pengguna    Int
  tanggal        DateTime       @db.DateTime(0)
  jenis_kejadian String         @db.VarChar(100)
  deskripsi      String         @db.Text
  tindak_lanjut  String?        @db.Text
  status         StatusKejadian @default(baru)
  pengguna       pengguna       @relation(fields: [id_pengguna], references: [id_pengguna], onDelete: Cascade)

  @@index([id_pengguna])
}

model stock_opname {
  id_opname           Int                   @id @default(autoincrement())
  id_pengguna         Int
  tanggal_mulai       DateTime              @db.Date
  tanggal_selesai     DateTime?             @db.Date
  status              StatusOpname          @default(berjalan)
  pengguna            pengguna              @relation(fields: [id_pengguna], references: [id_pengguna], onDelete: Cascade)
  detail_stock_opname detail_stock_opname[]

  @@index([id_pengguna])
}

model detail_stock_opname {
  id_detail        Int             @id @default(autoincrement())
  id_opname        Int
  id_eksemplar     Int
  status_ditemukan StatusDitemukan
  catatan          String?         @db.VarChar(255)
  stock_opname     stock_opname    @relation(fields: [id_opname], references: [id_opname], onDelete: Cascade)
  eksemplar        eksemplar       @relation(fields: [id_eksemplar], references: [id_eksemplar], onDelete: Cascade)

  @@index([id_opname])
  @@index([id_eksemplar])
}

model log_aktivitas {
  id_log          BigInt   @id @default(autoincrement())
  id_pengguna     Int
  aktivitas       String   @db.VarChar(150)
  tabel_terdampak String   @db.VarChar(50)
  waktu           DateTime @default(now()) @db.DateTime(0)
  pengguna        pengguna @relation(fields: [id_pengguna], references: [id_pengguna], onDelete: Cascade)

  @@index([id_pengguna])
}

model parameter_kebijakan {
  id_parameter   Int    @id @default(autoincrement())
  nama_parameter String @unique @db.VarChar(100)
  nilai          String @db.VarChar(50)
  keterangan     String? @db.VarChar(255)
}
